{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CyberSentinel Ground Truth Scenario",
  "description": "Schema for evaluation/ground_truth/scenarios.json entries",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["scenario_id", "name", "description", "alerts", "ground_truth"],
    "properties": {
      "scenario_id": {
        "type": "string",
        "pattern": "^S\\d{3}$",
        "description": "Unique scenario identifier e.g. S001"
      },
      "name": {
        "type": "string",
        "description": "Short human-readable name for the scenario"
      },
      "description": {
        "type": "string",
        "description": "One-sentence description of what the scenario tests"
      },
      "alerts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["alert_id", "timestamp", "src_ip", "dst_ip", "dst_port", "protocol", "attack_type"],
          "properties": {
            "alert_id":           { "type": "string" },
            "timestamp":          { "type": "string" },
            "src_ip":             { "type": "string" },
            "dst_ip":             { "type": "string" },
            "dst_port":           { "type": "integer", "minimum": 0, "maximum": 65535 },
            "protocol":           { "type": "string", "enum": ["TCP", "UDP", "ICMP", "HOPOPT"] },
            "attack_type":        { "type": "string" },
            "flow_bytes_per_sec": { "type": "number", "minimum": 0 },
            "packet_count":       { "type": "integer", "minimum": 0 }
          }
        }
      },
      "ground_truth": {
        "type": "object",
        "required": ["session_count", "attacker_ips", "kill_chain", "kill_chain_labels", "severity_band"],
        "properties": {
          "session_count": {
            "type": "integer",
            "minimum": 1,
            "description": "Expected number of distinct attacker sessions DBASC should produce"
          },
          "attacker_ips": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Source IPs that DBASC should identify as attacker origins"
          },
          "kill_chain": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TA\\d{4}$"
            },
            "description": "Ordered list of expected MITRE ATT&CK tactic IDs"
          },
          "kill_chain_labels": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Human-readable tactic names matching kill_chain order"
          },
          "mitre_techniques": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Specific MITRE technique IDs expected in the narrative"
          },
          "severity_band": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "Expected severity classification"
          },
          "sessions": {
            "type": "object",
            "description": "Per-session ground truth for multi-attacker scenarios (optional)"
          },
          "annotator_notes": {
            "type": "string",
            "description": "Free-text annotation explaining key decisions in this scenario"
          }
        }
      }
    }
  }
}