# CyberSentinel Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env.

# LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Database (SQLite — simpler on Windows, switch to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/cybersentinel.db

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=cybersentinel_kb

# Redis (run via Docker: docker run -d -p 6379:6379 redis:7-alpine)
REDIS_URL=redis://localhost:6379

# Auth
SECRET_KEY=replace-this-with-a-64-char-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# RAG / CGAR settings
RAG_TOP_K=5
CONFIDENCE_THRESHOLD=0.70
MAX_RETRIEVAL_ROUNDS=2

# App
DEBUG=true
ALLOWED_ORIGINS=http://localhost:8501
